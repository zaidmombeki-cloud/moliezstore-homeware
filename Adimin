<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Moliez Store Admin</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f6f6f6;
      color: #171717;
    }

    header {
      background: #111;
      color: white;
      padding: 18px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header strong {
      font-size: 20px;
    }

    .gold {
      color: #d4a84f;
    }

    main {
      max-width: 1100px;
      margin: auto;
      padding: 25px 18px;
    }

    .welcome {
      margin-bottom: 25px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 15px;
    }

    .card {
      background: white;
      padding: 22px;
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0,0,0,.08);
    }

    .card h3 {
      margin-top: 0;
    }

    .number {
      font-size: 30px;
      font-weight: bold;
      color: #b88b2d;
    }

    .section {
      background: white;
      margin-top: 20px;
      padding: 22px;
      border-radius: 15px;
    }

    button {
      background: #c89b3c;
      color: #111;
      border: 0;
      padding: 12px 18px;
      border-radius: 9px;
      font-weight: bold;
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .menu {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
    }

    .menu a {
      background: #111;
      color: white;
      padding: 16px;
      border-radius: 10px;
      text-align: center;
    }
  </style>
</head>

<body>

<header>
  <strong>MOLIEZ <span class="gold">STORE</span></strong>
  <a href="../">View Website ↗</a>
</header>

<main>

  <div class="welcome">
    <h1>Admin Dashboard</h1>
    <p>Karibu kwenye mfumo wa usimamizi wa Moliez Store Homeware.</p>
  </div>

  <div class="cards">

    <div class="card">
      <h3>Products</h3>
      <div class="number">0</div>
      <p>Bidhaa kwenye website</p>
    </div>

    <div class="card">
      <h3>Orders</h3>
      <div class="number">0</div>
      <p>Oda mpya</p>
    </div>

    <div class="card">
      <h3>Messages</h3>
      <div class="number">0</div>
      <p>Ujumbe wa wateja</p>
    </div>

    <div class="card">
      <h3>Promotion</h3>
      <div class="number">10%</div>
      <p>WELCOME10</p>
    </div>

  </div>

  <div class="section">

    <h2>Website Management</h2>

    <div class="menu">

      <a href="#">📦 Products</a>

      <a href="#">🛒 Orders</a>

      <a href="#">💬 Messages</a>

      <a href="#">🎁 Promotions</a>

      <a href="#">🔍 SEO</a>

      <a href="#">📊 Analytics</a>

    </div>

  </div>

  <div class="section">

    <h2>Quick Actions</h2>

    <button onclick="alert('Product management itaongezwa kwenye hatua inayofuata.')">
      + Add Product
    </button>

  </div>

</main>

</body>
</html>
